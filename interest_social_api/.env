# Flask配置
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=False
HOST=0.0.0.0
PORT=5000

# 密钥配置（生产环境请使用强随机字符串
SECRET_KEY=change-this-in-production-strong-random-string-32chars
JWT_SECRET_KEY=change-this-jwt-secret-in-production-strong-random-string-32chars

# JWT过期时间配置（分钟）
JWT_ACCESS_TOKEN_EXPIRES=15
JWT_REFRESH_TOKEN_EXPIRES=7

# CORS配置
CORS_ORIGINS=*

# 会话安全配置
SESSION_COOKIE_SECURE=True

# 加密密钥（用于敏感数据加密）
ENCRYPTION_KEY=wnqXMCjs8htuOlg-rcKddf_zmskCVOFPIjr1SHhf56E=

# API密钥认证（可选
API_KEY_HEADER=X-API-Key
API_KEY=your-api-key-here-for-service-to-service

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log